RAMALS_DB_NAME=
RAMALS_DB_ADMIN_USER=
RAMALS_DB_ADMIN_PASSWORD=
RAMALS_DB_RUNTIME_USER=ramals_core_runtime
RAMALS_DB_RUNTIME_PASSWORD=
RAMALS_DB_MIGRATION_USER=ramals_core_migration
RAMALS_DB_MIGRATION_PASSWORD=
KEYCLOAK_DB_NAME=
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=
RAMALS_KEYCLOAK_ADMIN=
RAMALS_KEYCLOAK_ADMIN_PASSWORD=
RAMALS_OIDC_ISSUER_URI=
RAMALS_OIDC_AUDIENCE=ramals-api
RAMALS_WEB_ORIGIN=
# Comma-separated CIDRs whose requests may carry a trusted X-Forwarded-For. Empty means no proxy
# is trusted and the immediate peer address is used. Set this to the network the reverse proxy in
# front of the platform actually connects from; never to 0.0.0.0/0.
RAMALS_TRUSTED_PROXIES=
RAMALS_REGISTRATION_ENABLED=false
RAMALS_ENVIRONMENT=dev
RAMALS_KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
RAMALS_REGISTRATION_ADMIN_CLIENT_ID=ramals-registration-admin
RAMALS_REGISTRATION_ADMIN_CLIENT_SECRET=
RAMALS_REGISTRATION_VERIFICATION_CLIENT_ID=ramals-web-ui
RAMALS_REGISTRATION_VERIFICATION_REDIRECT_URI=http://localhost:5173/
# Interactive administrative identity operations use a different Keycloak workload credential
# from public learner registration (M1-ADR-017).
RAMALS_ADMIN_IDENTITY_BASE_URL=http://keycloak:8080
RAMALS_ADMIN_IDENTITY_REALM=ramals
RAMALS_ADMIN_IDENTITY_CLIENT_ID=ramals-identity-admin
RAMALS_ADMIN_IDENTITY_CLIENT_SECRET=
# Comma-separated version:base64-encoded-key entries; use at least 32 random bytes per key.
RAMALS_OTP_HMAC_KEY_VERSION=v1
RAMALS_OTP_HMAC_KEYS=
RAMALS_OTP_POLICY_VERSION=otp-v1
RAMALS_SMS_PROVIDER=fake
# Bounds outbound SMS spend across the whole deployment, not per learner.
RAMALS_SMS_GLOBAL_HOURLY_BUDGET=100
RAMALS_ABUSE_COUNTER_RETENTION_DAYS=7
RAMALS_MAILPIT_PORT=8025
RAMALS_AI_BASE_URL=
RAMALS_AI_WORKLOAD_TOKEN_URL=
RAMALS_AI_WORKLOAD_CLIENT_ID=ramals-core-workload
RAMALS_AI_WORKLOAD_CLIENT_SECRET=
RAMALS_AI_WORKLOAD_AUDIENCE=ramals-ai
RAMALS_AI_DISPATCHER_ENABLED=true
RAMALS_AI_DISPATCHER_POLL_INTERVAL_MS=1000
RAMALS_AI_DISPATCHER_BATCH_SIZE=4
RAMALS_AI_DISPATCHER_LEASE_MS=60000
RAMALS_AI_DISPATCHER_MAX_ATTEMPTS=5
RAMALS_AI_DISPATCHER_INITIAL_BACKOFF_MS=1000
RAMALS_AI_DISPATCHER_MAX_BACKOFF_MS=60000
