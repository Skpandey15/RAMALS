{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramals.io/contracts/mvp2/assessment-evaluation-proposal.v1.schema.json",
  "title": "RAMALS MVP-2 AssessmentEvaluationProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "proposalId", "requestId", "agentRunId", "answerVersion", "rubricVersion", "dimensions", "feedback", "evidenceIds", "confidence"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "proposalId": { "$ref": "#/$defs/id" },
    "requestId": { "$ref": "#/$defs/id" },
    "agentRunId": { "$ref": "#/$defs/id" },
    "answerVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "rubricVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "dimensions": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/dimension" } },
    "feedback": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "evidenceIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensionId", "score", "maxScore", "reason"],
      "properties": {
        "dimensionId": { "$ref": "#/$defs/id" },
        "score": { "type": "number", "minimum": 0 },
        "maxScore": { "type": "number", "exclusiveMinimum": 0 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
