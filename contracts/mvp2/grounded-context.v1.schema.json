{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramals.io/contracts/mvp2/grounded-context.v1.schema.json",
  "title": "RAMALS MVP-2 GroundedContext v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "contextId", "learnerRef", "asOf", "expiresAt", "retrievalPolicyVersion", "items"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "contextId": { "$ref": "#/$defs/id" },
    "learnerRef": { "$ref": "#/$defs/id" },
    "asOf": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "retrievalPolicyVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "items": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/contextItem" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceType", "sourceVersion", "authority", "factType", "value", "observedAt"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "sourceType": { "enum": ["LEARNER_EVIDENCE", "MASTERY", "SKILL_GRAPH", "ASSESSMENT", "APPROVED_CONTENT", "CURRICULUM_POLICY", "DOMAIN_POLICY"] },
        "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "authority": { "enum": ["AUTHORITATIVE_FACT", "MODEL_GENERATED_SUMMARY"] },
        "factType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "value": {
          "anyOf": [
            { "type": "string", "maxLength": 2048 },
            { "type": "number" },
            { "type": "integer" },
            { "type": "boolean" }
          ]
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
