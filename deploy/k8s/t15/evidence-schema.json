{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ramals.example.invalid/m2-t15/evidence-schema.json",
  "title": "RAMALS M2-T15 qualification evidence",
  "description": "Schema for candidate-integrity.json and future scenario.json artifacts. The example is documentation only.",
  "oneOf": [
    {
      "$ref": "#/$defs/candidateIntegrity"
    },
    {
      "$ref": "#/$defs/scenarioEvidence"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": ["name", "repository", "digest", "reference"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "repository": {
          "$ref": "#/$defs/nonEmpty"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "reference": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "migration": {
      "type": "object",
      "required": ["version", "success"],
      "properties": {
        "version": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "qualification",
        "sourceCommit",
        "sourceTree",
        "lockSha256",
        "imageDigests",
        "manifest",
        "migrationSet",
        "liveMigrationHistory"
      ],
      "properties": {
        "qualification": {
          "$ref": "#/$defs/nonEmpty"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "sourceTree": {
          "$ref": "#/$defs/commit"
        },
        "lockSha256": {
          "$ref": "#/$defs/hash"
        },
        "imageDigests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/image"
          }
        },
        "manifest": {
          "type": "object",
          "required": ["kustomizationSha256", "renderedManifestSha256"],
          "properties": {
            "kustomizationSha256": {
              "$ref": "#/$defs/hash"
            },
            "renderedManifestSha256": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "migrationSet": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          }
        },
        "liveMigrationHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/migration"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["name", "result", "observed"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "result": {
          "enum": ["PASS", "FAIL"]
        },
        "observed": {
          "type": "string"
        }
      }
    },
    "dispatchCheckpoint": {
      "type": "object",
      "required": ["name", "state", "providerInvocationCount"],
      "properties": {
        "name": {
          "enum": [
            "after-commission-before-death",
            "after-death-before-reclaim",
            "replacement-held",
            "after-dispatch-acquisition",
            "in-flight-before-provider",
            "final"
          ]
        },
        "capturedAtUtc": { "type": "string" },
        "state": {
          "enum": ["", "AVAILABLE", "DISPATCH_OWNED", "IN_FLIGHT", "LEGACY_INDETERMINATE"]
        },
        "ownerToken": { "type": "string" },
        "fence": { "type": "string" },
        "providerInvocationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "inFlightProof": {
      "type": "object",
      "description": "Durable proof that a learning-platform death while the dispatch row was IN_FLIGHT was resolved as INDETERMINATE by a different worker, with no redispatch. Required for a passing diagnostic-in-flight scenario. The unchanged fence is the load-bearing fact: only the acquisition CAS increments it, so fence=1 across the death is itself the proof that no replacement redispatched.",
      "required": [
        "schema",
        "result",
        "requestId",
        "runId",
        "fence",
        "ownerToken",
        "preDeathState",
        "finalState",
        "providerInvocations",
        "deletedPodUid",
        "replacementPodUid",
        "durable",
        "checks"
      ],
      "properties": {
        "schema": { "const": "m2-t15.in-flight-indeterminate-proof.v1" },
        "result": { "enum": ["PASS", "FAIL"] },
        "requestId": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "fence": { "type": "string", "const": "1" },
        "ownerToken": { "type": "string", "minLength": 1 },
        "preDeathState": { "type": "string", "const": "IN_FLIGHT" },
        "finalState": { "type": "string", "const": "IN_FLIGHT" },
        "providerInvocations": { "type": "integer", "minimum": 1, "maximum": 1 },
        "deletedPodUid": { "type": "string", "minLength": 1 },
        "replacementPodUid": { "type": "string", "minLength": 1 },
        "workflowTokenA": { "type": ["string", "null"] },
        "durable": {
          "type": "object",
          "required": [
            "executionStatus",
            "errorCode",
            "succeededExecutions",
            "startedEvents",
            "indeterminateEvents",
            "gateDecisions",
            "adaptStatus",
            "evidenceRows",
            "masterySnapshots"
          ],
          "properties": {
            "executionStatus": { "const": "INDETERMINATE" },
            "errorCode": { "const": "AI_EXECUTION_OUTCOME_INDETERMINATE" },
            "succeededExecutions": { "const": "0" },
            "startedEvents": { "const": "1" },
            "indeterminateEvents": { "const": "1" },
            "gateDecisions": { "const": "0" },
            "adaptStatus": { "const": "SKIPPED" },
            "evidenceRows": { "const": "1" },
            "masterySnapshots": { "const": "1" }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "result", "observed"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "result": { "enum": ["PASS", "FAIL"] },
              "observed": { "type": "string" }
            }
          }
        }
      }
    },
    "dispatchProof": {
      "type": "object",
      "description": "Durable proof of the diagnostic dispatch-ownership state machine. Required for a passing diagnostic-commission scenario: aggregate row counts alone are never accepted as evidence of recovery.",
      "required": [
        "schema",
        "result",
        "requestId",
        "commissionEventId",
        "contextId",
        "contextAsOf",
        "ownerToken",
        "fence",
        "finalState",
        "ownershipAcquiredAt",
        "invocationStartedAt",
        "acquisitionEvidence",
        "inFlightEvidence",
        "observedStateSequence",
        "providerInvocations",
        "checkpoints",
        "checks"
      ],
      "properties": {
        "schema": { "const": "m2-t15.dispatch-ownership-proof.v1" },
        "result": { "const": "PASS" },
        "requestId": { "$ref": "#/$defs/nonEmpty" },
        "commissionEventId": { "$ref": "#/$defs/nonEmpty" },
        "contextId": { "$ref": "#/$defs/nonEmpty" },
        "contextAsOf": { "$ref": "#/$defs/nonEmpty" },
        "ownerToken": { "$ref": "#/$defs/nonEmpty" },
        "fence": { "type": "integer", "minimum": 1, "maximum": 1 },
        "finalState": { "const": "IN_FLIGHT" },
        "ownershipAcquiredAt": { "$ref": "#/$defs/nonEmpty" },
        "invocationStartedAt": { "$ref": "#/$defs/nonEmpty" },
        "acquisitionEvidence": { "enum": ["sampled", "durable-reconstruction"] },
        "inFlightEvidence": { "enum": ["sampled", "durable-reconstruction"] },
        "observedStateSequence": { "type": "array", "items": { "type": "string" } },
        "workflowTokenA": { "$ref": "#/$defs/nonEmpty" },
        "workflowTokenB": { "$ref": "#/$defs/nonEmpty" },
        "attemptA": { "type": "integer", "minimum": 1, "maximum": 1 },
        "attemptB": { "type": "integer", "minimum": 2, "maximum": 2 },
        "podUidA": { "$ref": "#/$defs/nonEmpty" },
        "podUidB": { "$ref": "#/$defs/nonEmpty" },
        "providerInvocations": { "type": "integer", "minimum": 1, "maximum": 1 },
        "checkpoints": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/dispatchCheckpoint" }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "contentionClaimAttempt": {
      "type": "object",
      "required": [
        "podUid",
        "runId",
        "step",
        "claimAttempt",
        "result"
      ],
      "properties": {
        "podUid": {
          "$ref": "#/$defs/nonEmpty"
        },
        "podName": {
          "type": "string"
        },
        "runId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "step": {
          "$ref": "#/$defs/nonEmpty"
        },
        "claimAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "result": {
          "enum": ["WON", "LOST"]
        },
        "executionToken": {
          "type": ["string", "null"]
        },
        "backendPid": {
          "type": "string"
        },
        "clientIp": {
          "type": "string"
        },
        "observedAtUtc": {
          "type": "string"
        },
        "waitEventType": {
          "type": "string"
        },
        "waitEvent": {
          "type": "string"
        },
        "claimSql": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "WON"
              }
            }
          },
          "then": {
            "required": ["executionToken"]
          }
        }
      ]
    },
    "candidateIntegrity": {
      "type": "object",
      "required": [
        "schema",
        "qualification",
        "result",
        "capturedAtUtc",
        "approvedCommit",
        "approvedRef",
        "checks"
      ],
      "properties": {
        "schema": {
          "const": "m2-t15.candidate-integrity.v1"
        },
        "qualification": {
          "const": "M2-T15.1"
        },
        "result": {
          "enum": ["PASS", "FAIL"]
        },
        "capturedAtUtc": {
          "$ref": "#/$defs/nonEmpty"
        },
        "approvedCommit": {
          "$ref": "#/$defs/commit"
        },
        "approvedRef": {
          "$ref": "#/$defs/nonEmpty"
        },
        "approvedRefCommit": {
          "$ref": "#/$defs/commit"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "environment": {
          "type": "object",
          "required": [
            "context",
            "namespace",
            "kubernetes",
            "k3d",
            "replicas",
            "podUids",
            "podImages",
            "featureFlagsAndConfiguration"
          ],
          "properties": {
            "context": {
              "$ref": "#/$defs/nonEmpty"
            },
            "namespace": {
              "$ref": "#/$defs/nonEmpty"
            },
            "kubernetes": {
              "type": "object"
            },
            "k3d": {
              "$ref": "#/$defs/nonEmpty"
            },
            "replicas": {
              "type": "array"
            },
            "podUids": {
              "type": "array"
            },
            "podImages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "uid", "containers"],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/nonEmpty"
                  },
                  "uid": {
                    "$ref": "#/$defs/nonEmpty"
                  },
                  "containers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["name", "image", "imageID"],
                      "properties": {
                        "name": {
                          "$ref": "#/$defs/nonEmpty"
                        },
                        "image": {
                          "$ref": "#/$defs/nonEmpty"
                        },
                        "imageID": {
                          "$ref": "#/$defs/nonEmpty"
                        }
                      }
                    }
                  }
                }
              }
            },
            "featureFlagsAndConfiguration": {
              "type": "object"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            }
          },
          "then": {
            "required": ["candidate", "environment"]
          }
        }
      ]
    },
    "scenarioEvidence": {
      "type": "object",
      "required": [
        "schema",
        "scenarioId",
        "result",
        "candidate",
        "initialState",
        "perturbation",
        "podLifecycle",
        "correlations",
        "claim",
        "workflowCursor",
        "durableState",
        "logsAndTraces",
        "kubernetesEvents",
        "expectedInvariant",
        "observedInvariant"
      ],
      "properties": {
        "schema": {
          "const": "m2-t15.scenario-evidence.v1"
        },
        "scenarioId": {
          "$ref": "#/$defs/nonEmpty"
        },
        "result": {
          "enum": ["PASS", "FAIL"]
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "initialState": {
          "$ref": "#/$defs/nonEmpty"
        },
        "perturbation": {
          "type": "object"
        },
        "podLifecycle": {
          "type": "object",
          "required": ["deletedPod", "deletedPodUid", "replacementPod", "replacementPodUid"],
          "properties": {
            "deletedPod": {
              "type": "string"
            },
            "deletedPodUid": {
              "type": "string"
            },
            "replacementPod": {
              "type": "string"
            },
            "replacementPodUid": {
              "type": "string"
            }
          }
        },
        "correlations": {
          "type": "object",
          "required": [
            "requestId",
            "diagnosticRequestId",
            "interactionId",
            "traceId",
            "evaluationDecisionId",
            "aiExecutionIds",
            "runId"
          ],
          "properties": {
            "requestId": {
              "$ref": "#/$defs/nonEmpty"
            },
            "diagnosticRequestId": {
              "$ref": "#/$defs/nonEmpty"
            },
            "interactionId": {
              "$ref": "#/$defs/nonEmpty"
            },
            "traceId": {
              "$ref": "#/$defs/nonEmpty"
            },
            "evaluationDecisionId": {
              "$ref": "#/$defs/nonEmpty"
            },
            "aiExecutionIds": {
              "type": "array"
            },
            "runId": {
              "$ref": "#/$defs/nonEmpty"
            }
          }
        },
        "claim": {
          "type": "object",
          "required": [
            "ownerPod",
            "ownerPodUid",
            "executionToken",
            "attemptCount",
            "staleWorkflowCas",
            "staleOutboxCas"
          ],
          "properties": {
            "ownerPod": {
              "type": "string"
            },
            "ownerPodUid": {
              "type": "string"
            },
            "executionToken": {
              "type": "string"
            },
            "attemptCount": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "staleWorkflowCas": {
              "type": "string"
            },
            "staleOutboxCas": {
              "type": "string"
            }
          }
        },
        "claimAttempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contentionClaimAttempt"
          }
        },
        "claimInstrumentation": {
          "type": ["object", "null"]
        },
        "workflowCursor": {
          "type": "object",
          "required": ["history", "final"],
          "properties": {
            "history": {
              "$ref": "#/$defs/nonEmpty"
            },
            "final": {
              "type": "object"
            }
          }
        },
        "durableState": {
          "type": "object",
          "required": ["before", "after", "decisionOutboxAiCorrelation"],
          "properties": {
            "before": {
              "$ref": "#/$defs/nonEmpty"
            },
            "after": {
              "$ref": "#/$defs/nonEmpty"
            },
            "decisionOutboxAiCorrelation": {
              "$ref": "#/$defs/nonEmpty"
            }
          }
        },
        "logsAndTraces": {
          "type": "object",
          "required": ["deletedPod", "survivingPods", "correlationIds"],
          "properties": {
            "deletedPod": {
              "$ref": "#/$defs/nonEmpty"
            },
            "survivingPods": {
              "$ref": "#/$defs/nonEmpty"
            },
            "correlationIds": {
              "$ref": "#/$defs/nonEmpty"
            }
          }
        },
        "kubernetesEvents": {
          "$ref": "#/$defs/nonEmpty"
        },
        "expectedInvariant": {
          "type": "object"
        },
        "observedInvariant": {
          "type": "object"
        },
        "dispatchProof": {
          "oneOf": [{ "$ref": "#/$defs/dispatchProof" }, { "type": "null" }]
        },
        "inFlightProof": {
          "oneOf": [{ "$ref": "#/$defs/inFlightProof" }, { "type": "null" }]
        },
        "failClosedTerminal": { "type": ["object", "null"] },
        "inFlightEvidence": { "type": ["object", "null"] },
        "dispatchCheckpoints": { "type": ["array", "null"] },
        "dispatchSamples": { "type": ["array", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scenarioId": {
                "const": "contention"
              }
            }
          },
          "then": {
            "required": ["claimAttempts", "claimInstrumentation"],
            "properties": {
              "claimAttempts": {
                "minItems": 2,
                "maxItems": 2
              },
              "claimInstrumentation": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scenarioId": { "const": "diagnostic-commission" },
              "result": { "const": "PASS" }
            },
            "required": ["scenarioId", "result"]
          },
          "then": {
            "required": ["dispatchProof"],
            "properties": {
              "dispatchProof": { "$ref": "#/$defs/dispatchProof" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scenarioId": { "const": "diagnostic-in-flight" },
              "result": { "const": "PASS" }
            },
            "required": ["scenarioId", "result"]
          },
          "then": {
            "required": ["inFlightProof"],
            "properties": {
              "inFlightProof": { "$ref": "#/$defs/inFlightProof" }
            }
          }
        }
      ]
    }
  }
}
